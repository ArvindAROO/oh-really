{
  "name": "oh-really",
  "version": "0.0.0",
  "private": true,
  "description": "Run any CLI tool so it can only touch the folder you're working in.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "oh-really": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "profiles"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "sandbox",
    "security",
    "cli",
    "privacy",
    "ai-agents"
  ],
  "dependencies": {
    "commander": "^15.1.0",
    "koffi": "^3.3.8",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
